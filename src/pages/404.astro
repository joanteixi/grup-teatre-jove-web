---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout titol="Pàgina no trobada" descripcio="Aquesta pàgina no existeix.">
  <section class="seccio seccio--blanc">
    <div class="container centre">
      <p class="etiqueta">Error 404</p>
      <h1>Aquesta pàgina no està en cartell</h1>
      <p class="prosa">
        Deu ser que l'hem retirada, o que l'enllaç porta a un lloc que no
        existeix. Torna a l'inici i ho trobaràs tot.
      </p>
      <p class="mt-2">
        <a class="btn btn--vi" href="/">Tornar a l'inici</a>
      </p>
    </div>
  </section>
</BaseLayout>
