---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

// Enllaç al formulari d'inscripció (es canvia només aquí).
const enllacInscripcio =
  "https://docs.google.com/spreadsheets/d/1KchHzd-Kti-dU3gowVLYjQfu8Yx4GS26brkywfkPTnE/edit?usp=sharing";
const esExtern = enllacInscripcio.startsWith("http");

const grups = [
  {
    dia: "Dilluns",
    nom: "Iniciació al teatre",
    hora: "De 17 h a 18 h",
    preu: "35",
    accent: "vi",
    text:
      "El primer contacte amb l'escenari. Jocs teatrals, expressió corporal, veu i improvisació per perdre la vergonya i descobrir que actuar és, sobretot, jugar.",
  },
  {
    dia: "Dissabte",
    nom: "Teatre musical",
    hora: "De 10 h a 13 h",
    preu: "75",
    accent: "or",
    text:
      "Cant, dansa i interpretació en una mateixa classe. Treballem un musical de cap a peus i el posem en escena davant del públic.",
  },
];

const calendari = [
  {
    data: "2 de novembre",
    titol: "Comença el curs",
    text: "Primera classe. No cal portar res: només ganes.",
  },
  {
    data: "Tot el curs",
    titol: "Una classe cada setmana",
    text: "El dia que triïs, dilluns o dissabte, sempre amb el mateix grup.",
  },
  {
    data: "28 de juny",
    titol: "Tanquem el teló",
    text: "Última classe del curs. Al juny hi ha la representació.",
  },
];
---

<BaseLayout
  titol="Escola de teatre"
  descripcio={`Escola de teatre per a infants i joves de 5 a 12 anys a ${site.poble}: iniciació al teatre els dilluns i teatre musical els dissabtes. Curs 2026-2027.`}
>
  <section class="escola-hero">
    <div class="container escola-hero__in">
      <p class="escola-hero__eyebrow">Escola de teatre · Curs 2026-2027</p>
      <h1>Aquí comença<br />el teu personatge</h1>
      <p class="escola-hero__lead">
        Una escola de teatre per a petits i joves, de 5 a 12 anys. Juguem, ens
        expressem i pugem a l'escenari. Aquest curs oferim dos grups: dilluns i
        dissabte.
      </p>

      <ul class="escola-hero__dades">
        <li><strong>5–12</strong><span>anys</span></li>
        <li><strong>2</strong><span>grups</span></li>
        <li><strong>Nov. – Juny</strong><span>curs</span></li>
        <li><strong>35–75 €</strong><span>al mes</span></li>
      </ul>

      <div class="escola-hero__accions">
        <a
          class="btn btn--primari"
          href={enllacInscripcio}
          target={esExtern ? "_blank" : undefined}
          rel={esExtern ? "noopener" : undefined}
        >
          Inscriu-te
        </a>
        <a class="btn btn--fantasma" href="#grups">Veure els grups</a>
      </div>
    </div>
  </section>

  <section class="seccio seccio--blanc" id="grups">
    <div class="container">
      <div class="escola-capçalera">
        <p class="etiqueta">Els grups</p>
        <h2>Dues maneres de fer teatre</h2>
        <p>
          Tria el dia que us vagi millor. Els dos grups van de novembre a juny i
          acaben amb una representació al Casal de Cultura.
        </p>
      </div>

      <div class="escola-grups">
        {
          grups.map((g) => (
            <article class={`grup grup--${g.accent}`}>
              <div class="grup__cap">
                <span class="grup__dia">{g.dia}</span>
                <span class="grup__preu">
                  {g.preu} €<small>al mes</small>
                </span>
              </div>
              <h3>{g.nom}</h3>
              <p class="grup__hora">{g.hora} · Casal de Cultura</p>
              <p class="grup__text">{g.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccio seccio--crema">
    <div class="container">
      <div class="escola-capçalera">
        <p class="etiqueta etiqueta--or">El calendari</p>
        <h2>Del 2 de novembre al 28 de juny</h2>
        <p>
          Els dos grups fan el mateix curs: comencen el mateix dia i acaben amb
          una representació al juny.
        </p>
      </div>

      <ol class="escola-curs">
        {
          calendari.map((c) => (
            <li class="escola-curs__pas">
              <span class="escola-curs__data">{c.data}</span>
              <strong>{c.titol}</strong>
              <p>{c.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="escola-escenari">
        <div>
          <h3>Al juny, tots a l'escenari</h3>
          <p>
            Cada grup prepara la seva representació i la fa davant de les
            famílies a la <strong>Sala Antolina Boada i Ferrer</strong>, la sala
            de teatre del Casal de Cultura de Vacarisses (carrer dels Oms, 1).
          </p>
        </div>
        <p class="escola-escenari__nota">
          Un escenari de debò, amb llums, vestuari i públic. Perquè l'esforç de
          tot el curs tingui la seva recompensa.
        </p>
      </div>
    </div>
  </section>

  <section class="seccio seccio--blanc">
    <div class="container escola-formacio">
      <div class="escola-formacio__text">
        <p class="etiqueta">Qui ho porta</p>
        <h2>Formació a càrrec de Puceduca</h2>
        <p>
          Les classes les fa l'equip de <strong>Puceduca Vacarisses</strong>,
          centre educatiu del poble. El Grup de Teatre Jove hi posa l'escenari,
          el vestuari i les ganes de fer teatre.
        </p>
        <p>
          Si tens qualsevol dubte sobre el grup que li toca o sobre la quota,
          escriu-nos i t'ho expliquem.
        </p>
        <p class="escola-formacio__enllacos">
          <a class="btn btn--vi" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <aside class="escola-quota">
        <p class="escola-quota__titol">Quotes</p>
        <ul>
          {
            grups.map((g) => (
              <li>
                <span>{g.nom}</span>
                <strong>{g.preu} €/mes</strong>
              </li>
            ))
          }
        </ul>
        <p class="escola-quota__peu">
          Del 2 de novembre al 28 de juny. La quota es paga mensualment.
        </p>
      </aside>
    </div>
  </section>

  <section class="seccio seccio--fosca">
    <div class="container centre escola-cta">
      <p class="etiqueta etiqueta--fosca">Inscripcions obertes</p>
      <h2>Vols una plaça?</h2>
      <p class="escola-cta__text">
        Omple el formulari i et direm què cal portar el primer dia. Si et queda
        cap dubte, també ens pots escriure directament.
      </p>
      <p class="escola-cta__accions">
        <a
          class="btn btn--primari"
          href={enllacInscripcio}
          target={esExtern ? "_blank" : undefined}
          rel={esExtern ? "noopener" : undefined}
        >
          Formulari d'inscripció
        </a>
        <a class="btn btn--fantasma" href={`mailto:${site.email}`}>Escriu-nos</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Capçalera de la pàgina ---------- */

  .escola-hero {
    position: relative;
    overflow: hidden;
    color: var(--blanc);
    background:
      radial-gradient(900px 460px at 8% -10%, rgba(139, 30, 63, 0.62), transparent 62%),
      radial-gradient(760px 420px at 95% 0%, rgba(224, 179, 74, 0.2), transparent 60%),
      linear-gradient(160deg, var(--fosc) 0%, var(--fosc-2) 58%, var(--fosc-3) 100%);
  }

  .escola-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.035) 0 2px,
      transparent 2px 38px
    );
  }

  .escola-hero__in {
    position: relative;
    z-index: 1;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
    max-width: 60rem;
  }

  .escola-hero__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--or);
  }

  .escola-hero h1 {
    margin: 0 0 0.6em;
    color: var(--blanc);
    font-size: clamp(2.4rem, 1.5rem + 4.2vw, 4.4rem);
    line-height: 1.02;
  }

  .escola-hero__lead {
    max-width: 36rem;
    font-size: clamp(1.03rem, 0.98rem + 0.35vw, 1.18rem);
    color: #dfe2ee;
  }

  .escola-hero__dades {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.4rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .escola-hero__dades li {
    display: flex;
    flex-direction: column;
    padding-left: 0.85rem;
    border-left: 2px solid var(--vi-clar);
  }

  .escola-hero__dades strong {
    font-family: var(--font-titols);
    font-size: 1.25rem;
    color: var(--blanc);
  }

  .escola-hero__dades span {
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a9aec6;
  }

  .escola-hero__accions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* ---------- Títols de secció ---------- */

  .escola-capçalera {
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .escola-capçalera h2 {
    margin-bottom: 0.35em;
  }

  .escola-capçalera p:last-child {
    color: var(--muted);
  }

  /* ---------- Targetes dels grups ---------- */

  .escola-grups {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .grup {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--blanc);
    border: 1px solid var(--vora);
    border-radius: var(--radi);
    box-shadow: var(--ombra);
    overflow: hidden;
  }

  .grup::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 5px;
    background: var(--vi);
  }

  .grup--or::before {
    background: var(--or);
  }

  .grup__cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .grup__dia {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--vi);
  }

  .grup--or .grup__dia {
    color: #8a6608;
  }

  .grup__preu {
    font-family: var(--font-titols);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }

  .grup__preu small {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-cos);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
    color: var(--muted);
  }

  .grup h3 {
    margin-bottom: 0.2em;
  }

  .grup__hora {
    margin-bottom: 0.9rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .grup__text {
    margin: 0;
    color: var(--muted);
  }

  /* ---------- El curs ---------- */

  .escola-curs {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .escola-curs__pas {
    position: relative;
    padding-top: 1.6rem;
    border-top: 2px solid var(--vora);
  }

  .escola-curs__pas::before {
    content: "";
    position: absolute;
    top: -0.42rem;
    left: 0;
    width: 0.66rem;
    height: 0.66rem;
    border-radius: 999px;
    background: var(--or-fosc);
    box-shadow: 0 0 0 4px var(--crema);
  }

  .escola-curs__data {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vi);
  }

  .escola-curs__pas strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-titols);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem);
    font-weight: 600;
  }

  .escola-curs__pas p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* ---------- L'escenari ---------- */

  .escola-escenari {
    display: grid;
    gap: clamp(1rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3.25rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--blanc);
    border-radius: var(--radi);
    border-left: 4px solid var(--or);
    box-shadow: var(--ombra);
  }

  .escola-escenari h3 {
    margin-bottom: 0.35em;
  }

  .escola-escenari p {
    margin: 0;
    color: var(--muted);
  }

  .escola-escenari__nota {
    font-family: var(--font-titols);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--vi) !important;
  }

  /* ---------- Formació i quotes ---------- */

  .escola-formacio {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .escola-formacio__text h2 {
    margin-bottom: 0.5em;
  }

  .escola-formacio__text p {
    color: var(--muted);
  }

  .escola-formacio__enllacos {
    margin-top: 1.5rem;
  }

  .escola-quota {
    padding: clamp(1.35rem, 3vw, 1.9rem);
    background: var(--crema);
    border: 1px solid var(--vora);
    border-radius: var(--radi);
  }

  .escola-quota__titol {
    margin: 0 0 0.75rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .escola-quota ul {
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }

  .escola-quota li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--vora);
    font-size: 0.97rem;
  }

  .escola-quota li:last-child {
    border-bottom: 0;
  }

  .escola-quota strong {
    font-family: var(--font-titols);
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .escola-quota__peu {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* ---------- Crida final ---------- */

  .escola-cta {
    max-width: 40rem;
  }

  .escola-cta__text {
    color: #dfe2ee;
  }

  .escola-cta__accions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin: 1.75rem 0 0;
  }
</style>
