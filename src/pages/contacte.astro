---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  titol="Contacte"
  descripcio={`Contacte del ${site.nom}: escriu-nos per participar al grup, apuntar-te a l'escola o demanar informació.`}
>
  <section class="seccio seccio--blanc">
    <div class="container">
      <h1>Contacte</h1>
      <p class="prosa">
        Escriu-nos i et responem al més aviat possible. Si ens expliques per a què
        ens escrius, t'ho podrem contestar millor.
      </p>
      <p class="mt-2">
        <a class="btn btn--vi" href={`mailto:${site.email}`}>
          Escriu-nos un correu
        </a>
      </p>

      <h2 class="mt-2">Dades de contacte</h2>
      <ul class="contacte__dades">
        <li>
          <strong>Correu</strong>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {site.telefon && (
          <li>
            <strong>Telèfon</strong>
            {site.telefon}
          </li>
        )}
        <li>
          <strong>On som</strong>
          {site.adreca}
        </li>
        {site.xarxes.map((x) => (
          <li>
            <strong>{x.nom}</strong>
            <a href={x.url} rel="me noopener" target="_blank">
              {x.text || x.url}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
